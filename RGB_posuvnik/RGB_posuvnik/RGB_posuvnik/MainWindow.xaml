<Window x:Class="RGB_posuvnik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RGB_posuvnik"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Slider x:Name="Red_slider" HorizontalAlignment="Left" Margin="566,93,0,0" VerticalAlignment="Top" Width="160" Maximum="255" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True"/>
        <Slider x:Name="Blue_slider" HorizontalAlignment="Left" Margin="566,207,0,0" VerticalAlignment="Top" Width="160" Maximum="255" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True"/>
        <Slider x:Name="Green_slider" HorizontalAlignment="Left" Margin="566,328,0,0" VerticalAlignment="Top" Width="160" Maximum="255" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True"/>
        <Label Content="Red" HorizontalAlignment="Left" Margin="627,49,0,0" VerticalAlignment="Top" Background="Red"/>
        <Label Content="Blue" HorizontalAlignment="Left" Margin="631,166,0,0" VerticalAlignment="Top" Background="#FF00D8FF"/>
        <Label Content="Green&#xD;&#xA;" HorizontalAlignment="Left" Margin="631,296,0,0" VerticalAlignment="Top" Background="#FF00FF03" Height="27"/>
        <TextBox x:Name="Red_value" HorizontalAlignment="Left" Margin="582,116,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="Red_value_TextChanged"/>
        <TextBox x:Name="Blue_value" HorizontalAlignment="Left" Margin="582,230,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="Blue_value_TextChanged"/>
        <TextBox x:Name="Green_value" HorizontalAlignment="Left" Margin="587,351,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="Green_value_TextChanged"/>
        <Rectangle x:Name="RGB_shower" HorizontalAlignment="Left" Height="217" Margin="179,91,0,0" VerticalAlignment="Top" Width="221" Fill="Red"/>
        <Label x:Name="Color_value" Content="Label" HorizontalAlignment="Left" Margin="271,351,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
